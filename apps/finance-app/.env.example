# Copy to .env. Requires docker-compose (Keycloak) running, with the
# iam-portal realm imported (see root docker-compose.yml).

# Auth.js (NextAuth) — generate your own secret: `openssl rand -base64 32`
AUTH_SECRET="changeme"
AUTH_KEYCLOAK_ID="finance-app"
AUTH_KEYCLOAK_SECRET="finance-app-dev-secret-change-me"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/iam-portal"

# Shared secret with the portal's /api/authz/check endpoint — must match its
# AUTHZ_SERVICE_SECRET exactly. This app has no database of its own; every
# access decision (does this Keycloak identity's Role grant this app?) is
# delegated to the portal over this authenticated call.
AUTHZ_SERVICE_SECRET="changeme"
