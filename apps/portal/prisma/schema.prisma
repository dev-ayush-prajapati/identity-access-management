generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  SUPERADMIN
  ADMIN
  EMPLOYEE
}

// ACTIVE is the only status a user can be created with; DISABLED is set by an
// Admin/SuperAdmin action (see api/users/[id]/route.ts) and is checked fresh
// from Postgres on every request — never cached in the session JWT — so
// disabling someone takes effect on their very next request, not their next
// login.
enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

model User {
  id           String     @id @default(cuid())
  keycloakId   String     @unique
  name         String
  email        String     @unique
  userType     UserType
  status       UserStatus @default(ACTIVE)
  // Set when an Admin/SuperAdmin "deletes" this user: the Keycloak login is
  // gone for good, but the Postgres row is kept (not hard-deleted) so the
  // audit trail's actor/target references never dangle. Non-null = archived;
  // filtered out of every user-management list and treated the same as "no
  // account" everywhere access is checked.
  archivedAt   DateTime?
  role         Role?      @relation(fields: [roleId], references: [id])
  roleId       String?
  createdBy    User?      @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdById  String?
  createdUsers User[]     @relation("UserCreatedBy")
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([roleId])
  @@index([userType])
}

model Role {
  id        String       @id @default(cuid())
  name      String       @unique
  users     User[]
  access    RoleAccess[]
  createdAt DateTime     @default(now())
}

model Application {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  url         String
  access      RoleAccess[]
  createdAt   DateTime     @default(now())
}

// Access Matrix: presence of a row = that Role can access that Application
model RoleAccess {
  id            String      @id @default(cuid())
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId        String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String

  @@unique([roleId, applicationId])
}

model AuditLog {
  id        String   @id @default(cuid())
  // Restrict, not the implicit SetNull an optional relation defaults to:
  // a User row is archived, never hard-deleted (see User.archivedAt), so
  // this relation should in practice never actually need to null out — if
  // something ever does try to hard-delete a referenced User, that must fail
  // loudly instead of silently erasing who did what.
  user       User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId     String?
  // Snapshot of the actor's name/email at write time, independent of the
  // `user` relation above — so a row stays human-readable even if the actor's
  // name later changes, or (belt-and-suspenders) the relation is ever gone.
  actorName  String?
  actorEmail String?
  action     String
  // Free-text summary, kept for the on-screen/CSV line — targetType/targetId/
  // metadata below are the queryable, structured side of the same event.
  details    String?
  targetType String?
  targetId   String?
  metadata   Json?
  outcome    AuditOutcome @default(SUCCESS)
  ip         String?
  userAgent  String?
  createdAt  DateTime     @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
}
