# Copy to .env and adjust. Requires docker-compose (Postgres + Keycloak) running.

DATABASE_URL="postgresql://iam_user:iam_password@localhost:5432/iam_db?schema=public"

# Keycloak admin (master realm) — used by one-off bootstrap scripts only
KEYCLOAK_BASE_URL="http://localhost:8080"
KEYCLOAK_REALM="iam-portal"
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"

# First SuperAdmin account (used once by scripts/bootstrap-superadmin.ts)
# Replace with your own values before running the script — do not commit real values.
SUPERADMIN_NAME="changeme"
SUPERADMIN_EMAIL="changeme@iam-portal.local"
SUPERADMIN_PASSWORD="changeme"

# Auth.js (NextAuth) — generate your own secret: `openssl rand -base64 32`
AUTH_SECRET="changeme"
AUTH_KEYCLOAK_ID="portal"
AUTH_KEYCLOAK_SECRET="portal-dev-secret-change-me"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/iam-portal"

# Shared secret between the portal and every app that calls its
# /api/authz/check endpoint (currently just finance-app) — must match that
# app's AUTHZ_SERVICE_SECRET exactly. Generate your own: `openssl rand -base64 32`
AUTHZ_SERVICE_SECRET="changeme"
