# Copy to .env and adjust if needed. Used by docker-compose.yml.
# Defaults below match docker-compose.yml's fallback values.
# These are placeholder credentials for LOCAL DEV ONLY (ports are bound to
# 127.0.0.1, not exposed to the network) — replace them before any use
# beyond your own machine.

# Postgres (app database, used by Prisma)
POSTGRES_USER=iam_user
POSTGRES_PASSWORD=iam_password
POSTGRES_DB=iam_db

# Keycloak bootstrap admin (Keycloak's own admin console login, not an app user)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
