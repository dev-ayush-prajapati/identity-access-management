# Copy to .env and adjust if needed. Used by docker-compose.yml.
# Defaults below match docker-compose.yml's fallback values — safe for local dev only.

# Postgres (app database, used by Prisma)
POSTGRES_USER=iam_user
POSTGRES_PASSWORD=iam_password
POSTGRES_DB=iam_db

# Keycloak bootstrap admin (Keycloak's own admin console login, not an app user)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
