{
  "realm": "iam-portal",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "portal",
      "name": "IAM Portal",
      "enabled": true,
      "publicClient": false,
      "secret": "portal-dev-secret-change-me",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "finance-app",
      "name": "Finance App (SSO proof stub)",
      "enabled": true,
      "publicClient": false,
      "secret": "finance-app-dev-secret-change-me",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "portal-admin",
      "name": "Portal user management (service account)",
      "description": "Used only by the portal's server side to create, disable, reset, and remove this realm's users. No login flow; client-credentials only.",
      "enabled": true,
      "publicClient": false,
      "secret": "portal-admin-dev-secret-change-me",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-portal-admin",
      "enabled": true,
      "serviceAccountClientId": "portal-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users"]
      }
    }
  ]
}
